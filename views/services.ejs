  <!-- Development Methodology & Process Timeline -->
  <div style="margin-top: var(--space-3xl);">
    <div class="section-header" style="text-align: center; max-width: 680px;">
      <div class="badge">Structured Workflow</div>
      <h2>Development & Engineering Methodology</h2>
      <p style="color: var(--text-muted);">A rigorous 5-step process ensuring quality from initial spec to final delivery.</p>
    </div>

    <div class="process-grid">
      <!-- Step 1 -->
      <div class="glass-card process-step">
        <div class="process-number">01</div>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-xs);">Requirements & PRD</h3>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          Gathering functional needs, defining tech stack invariants, and formalizing Product Requirement Specifications (`prd.md`).
        </p>
      </div>

      <!-- Step 2 -->
      <div class="glass-card process-step">
        <div class="process-number">02</div>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-xs);">System Architecture</h3>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          Drafting 1D/2D layer diagrams, ER/EER database models, user sequence flows, and folder organization (`architecture.md`).
        </p>
      </div>

      <!-- Step 3 -->
      <div class="glass-card process-step">
        <div class="process-number">03</div>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-xs);">Design System & Tokens</h3>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          Establishing Obsidian dark mode color variables, glassmorphism borders, typography tokens, and spacing scale (`design.md`).
        </p>
      </div>

      <!-- Step 4 -->
      <div class="glass-card process-step">
        <div class="process-number">04</div>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-xs);">Development & DB Sync</h3>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          Building Node.js routes, EJS views, Prisma ORM schema migrations, seeding initial data, and writing clean REST APIs.
        </p>
      </div>

      <!-- Step 5 -->
      <div class="glass-card process-step">
        <div class="process-number">05</div>
        <h3 style="font-size: 1.1rem; margin-bottom: var(--space-xs);">QA & Verification</h3>
        <p style="font-size: 0.88rem; color: var(--text-muted); margin: 0;">
          Testing endpoint status codes, validating DB CRUD operations, checking cross-device responsiveness, and delivering walkthrough logs.
        </p>
      </div>
    </div>
