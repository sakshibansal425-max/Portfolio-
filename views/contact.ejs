<section class="container" style="padding: var(--space-2xl) var(--space-md);">
  <!-- Header Banner -->
  <div class="section-header" style="text-align: left; max-width: 100%; margin-bottom: var(--space-2xl);">
    <div class="badge badge-status">Direct Communication</div>
    <h1 style="font-size: var(--size-h1); margin-top: var(--space-xs);">Contact Sakshi Bansal</h1>
    <p class="lead" style="max-width: 720px; color: var(--text-muted);">
      Have a technical inquiry, project opportunity, or recruitment question? Send a message directly. All submissions are logged securely in the local SQL database.
    </p>
  </div>

  <div class="contact-grid">
    <!-- Left Column: Contact Information & Availability -->
    <div>
      <div class="glass-card" style="margin-bottom: var(--space-xl);">
        <h3 style="margin-bottom: var(--space-md); border-bottom: 1px solid var(--border-light); padding-bottom: var(--space-xs);">
          Get in Touch
        </h3>
        
        <div style="display: flex; flex-direction: column; gap: var(--space-lg);">
          <!-- Email Block -->
          <div style="display: flex; gap: var(--space-md); align-items: start;">
            <div class="card-icon" style="width: 40px; height: 40px; border-radius: var(--radius-md); background: rgba(255,255,255,0.06); border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </div>
            <div>
              <span style="font-size: 0.85rem; color: var(--text-muted); display: block;">Primary Email</span>
              <a href="mailto:sakshibansal425@gmail.com" style="font-weight: 600; color: var(--accent-white); font-size: 1.05rem;">
                sakshibansal425@gmail.com
              </a>
            </div>
          </div>

          <!-- Response SLA Block -->
          <div style="display: flex; gap: var(--space-md); align-items: start;">
            <div class="card-icon" style="width: 40px; height: 40px; border-radius: var(--radius-md); background: rgba(255,255,255,0.06); border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
            </div>
            <div>
              <span style="font-size: 0.85rem; color: var(--text-muted); display: block;">Response Expectations</span>
              <span style="font-weight: 500; color: var(--accent-silver);">
                Within 24 Hours (Mon – Sat)
              </span>
            </div>
          </div>

          <!-- Location & Availability Block -->
          <div style="display: flex; gap: var(--space-md); align-items: start;">
            <div class="card-icon" style="width: 40px; height: 40px; border-radius: var(--radius-md); background: rgba(255,255,255,0.06); border: 1px solid var(--border-light); display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div>
              <span style="font-size: 0.85rem; color: var(--text-muted); display: block;">Location & Availability</span>
              <span style="font-weight: 500; color: var(--accent-silver);">
                India • Available for Remote Fullstack Roles
              </span>
            </div>
          </div>
        </div>
      </div>

      <!-- Social Profiles Card -->
      <div class="glass-card">
        <h4 style="margin-bottom: var(--space-md); color: var(--accent-white);">Connect on Professional Networks</h4>
        <div style="display: flex; gap: var(--space-md);">
          <a href="https://github.com" target="_blank" rel="noopener" class="btn btn-secondary" style="flex: 1;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>
            GitHub
          </a>
          <a href="https://linkedin.com" target="_blank" rel="noopener" class="btn btn-secondary" style="flex: 1;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
            LinkedIn
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Glassmorphic Contact Form -->
    <div>
      <div class="glass-card">
        <h3 style="margin-bottom: var(--space-xs);">Send a Message</h3>
        <p style="font-size: 0.9rem; color: var(--text-muted); margin-bottom: var(--space-lg);">
          Fill out the form below. Messages are saved directly to SQLite (`contacts` table).
        </p>

        <!-- Form Status Alert -->
        <div id="formAlert" class="alert"></div>

        <form id="contactForm">
          <div class="form-group">
            <label class="form-label" for="name">Your Name *</label>
            <input type="text" id="name" name="name" class="form-input" placeholder="e.g. Alex Johnson" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="email">Your Email Address *</label>
            <input type="email" id="email" name="email" class="form-input" placeholder="alex@company.com" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="subject">Subject / Inquiry Type *</label>
            <select id="subject" name="subject" class="form-select" required>
              <option value="" disabled selected>Select an option...</option>
              <option value="Recruitment & Job Offer">Recruitment & Job Opportunity</option>
              <option value="Fullstack Project Inquiry">Fullstack Web Project Inquiry</option>
              <option value="Database & SQL Architecture">Database & SQL Architecture</option>
              <option value="General Tech Discussion">General Tech & Govt Exam Discussion</option>
            </select>
          </div>

          <div class="form-group">
            <label class="form-label" for="message">Message Content *</label>
            <textarea id="message" name="message" class="form-textarea" rows="5" placeholder="Share project details, role description, or questions..." required></textarea>
          </div>

          <button type="submit" class="btn btn-primary" style="width: 100%; padding: 0.9rem; font-size: 1rem;">
            Send Message →
          </button>
        </form>
      </div>
    </div>
  </div>
</section>
